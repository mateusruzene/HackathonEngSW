{
  "name": "hackathon-ufpr",
  "version": "1.0.0",
  "description": "Sistema de Gestão de Hackathons Acadêmicos do DInf/UFPR",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "cd src/client && npm run dev",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd src/client && npm run build",
    "build": "npm run build:client && npm run build:server",
    "start": "tsx src/server/index.ts",
    "start:prod": "node dist/server/index.js",
    "test": "tsx tests/test_api.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "ufpr",
    "hackathon",
    "fastify",
    "knex",
    "sqlite3",
    "typescript",
    "zod",
    "react",
    "vite",
    "tailwind",
    "docker"
  ],
  "author": "Mateus Siqueira Ruzene, Gabriel Claudino de Souza",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.1",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
